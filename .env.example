# Copy this file to .env and fill it in. Never share or upload the real .env file.

# Staff logins as name:password,name:password  (passwords at least 10 characters, no commas)
STAFF_USERS=amanuel:replace-with-a-long-password,hanna:replace-with-another-one

# The public address of the site, no trailing slash
PUBLIC_URL=https://help.example.com
# The same address without https://  (used by docker-compose for the certificate)
DOMAIN=help.example.com

COMPANY_NAME=Nobicom Technology Integration PLC
SUPPORT_HOTLINE=+251 11 000 0001
SUPPORT_EMAIL=support@example.com

# Advanced (already set correctly by Dockerfile, render.yaml and docker-compose.yml)
# PORT=3000
# DB_PATH=./data/helpdesk.db
# NODE_ENV=production
# TRUST_PROXY=1     set to 1 only when a proxy or hosting service sits in front
# COOKIE_SECURE=1   forces secure cookies; not needed when TRUST_PROXY=1 and the proxy uses https
